# Historical benchmark datasets for PHACS-NMR parity tests
# Copy this file to .env and configure the local paths to enable historical integration tests.

# Path to historical 13C benchmark directory (contains 'PHBV_software - 13C')
PHACS_BENCHMARK_DIR="D:/path/to/PHBV_software - 13C"

# Path to historical 1H deconvolution benchmark directory (contains 'Global Software/Additional Info')
PHACS_GLOBAL_SOFTWARE_DIR="D:/path/to/Global Software/Additional Info"
